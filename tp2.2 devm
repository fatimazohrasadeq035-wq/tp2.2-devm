    {
        id: 1,
        nom: "Clavier",
        categorie: "Accessoires",
        prix: 120,
        stock: 5
    },
    {
        id: 2,
        nom: "Souris",
        categorie: "Accessoires",
        prix: 80,
        stock: 8
    },
    {
        id: 3,
        nom: "Écran",
        categorie: "Informatique",
        prix: 900,
        stock: 0
    },
    {
        id: 4,
        nom: "Casque",
        categorie: "Accessoires",
        prix: 240,
        stock: 3
    }
];

console.log("=== Catalogue des produits ===");
console.log(produits);
console.log("=== Liste des produits ===");

produits.forEach(function(produit) {
    console.log(produit.nom + " - " + produit.prix + " MAD");
});
const produitsDisponibles = produits.filter(function(produit) {
    return produit.stock > 0;
});

console.log("=== Produits disponibles ===");
console.log(produitsDisponibles);

console.log("Nombre de produits disponibles :", produitsDisponibles.length);
const valeurStock = produits.reduce(function(total, produit) {
    return total + (produit.prix * produit.stock);
}, 0);

console.log("=== Valeur totale du stock ===");
console.log(valeurStock, "MAD");
const moinsCher = produitsDisponibles.reduce(function(min, produit) {
    return produit.prix < min.prix ? produit : min;
});

console.log("=== Produit disponible le moins cher ===");
console.log(moinsCher.nom, "-", moinsCher.prix, "MAD");
const resume = produits.map(function(produit) {
    return produit.nom + " - " + produit.prix + " MAD - " + produit.stock + " unités";
});

console.log("=== Résumé du catalogue ===");
